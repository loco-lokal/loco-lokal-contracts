{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT c.account_id, a.name AS account_name, c.value\n        FROM encrypted_configs c\n        JOIN accounts a ON a.id = c.account_id\n        WHERE c.key = $1\n        ORDER BY c.account_id\n        LIMIT 1\n        ",
