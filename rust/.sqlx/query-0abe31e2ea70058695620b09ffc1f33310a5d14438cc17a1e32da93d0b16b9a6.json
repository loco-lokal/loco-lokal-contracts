  "db_name": "PostgreSQL",
  "query": "SELECT f.id AS \"id!\", f.name AS \"name!\", f.author_id AS \"author_id!\", f.account_id AS \"account_id!\", f.archived_at, f.parent_folder_id,\n                      CASE WHEN p.id IS NULL THEN f.name ELSE p.name || ' / ' || f.name END\n                        AS \"full_name!\"\n               FROM template_folders f\n               LEFT JOIN template_folders p ON p.id = f.parent_folder_id WHERE f.id = ANY($1)",
